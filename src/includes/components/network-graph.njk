        // filtering
        ["aTMFG", "TMFG"], ["aTMFG", "ANN"], ["aTMFG", "kNNGraph"], ["aTMFG", "PlanarGraphs"],
        ["aTMFG", "GraphRecovery"],
        ["TMFG", "PlanarGraphs"], ["TMFG", "Chordal"], ["TMFG", "MFCF"], ["MFCF", "Chordal"],
        ["CliqueStability", "TMFG"], ["CliqueStability", "MFCF"], ["CliqueStability", "GLasso"],
        ["CliqueStability", "Shrinkage"], ["CliqueStability", "CorrEstimation"], ["CliqueStability", "Portfolio"],
        ["CliqueStability", "HRP"], ["CliqueStability", "MinVar"], ["CliqueStability", "FactorModels"],
        ["CliqueStability", "GMRF"],
        ["GLasso", "Precision"], ["Precision", "GMRF"], ["RMT", "CorrEstimation"], ["Shrinkage", "CorrEstimation"],
        ["kNNGraph", "ANN"],

        // graph learning
        ["NeurIPS", "ML"], ["NeurIPS", "GraphAnalytics"],
        ["MSIMAP", "Manifold"], ["MSIMAP", "Embeddings"], ["MSIMAP", "Laplacian"], ["MSIMAP", "GraphAnalytics"],
        ["GraphRecovery", "GMRF"], ["GraphRecovery", "SBM"], ["GraphRecovery", "KTrees"], ["GraphRecovery", "kNNGraph"],
        ["GraphRecovery", "Laplacian"], ["GraphRecovery", "SyntheticData"],
        ["GraphsHelp", "GraphRecovery"], ["GraphsHelp", "GNN"], ["GraphsHelp", "GMRF"], ["GraphsHelp", "GSP"],
        ["GraphsHelp", "Learnability"],
        ["HNN", "MFCF"], ["HNN", "RelationalDL"], ["HNN", "Sparsity"], ["HNN", "AlgTopology"], ["HNN", "GNN"],
        ["InteractionGraphs", "Hypergraphs"], ["InteractionGraphs", "Learnability"],
        ["InteractionGraphs", "DistanceCorr"], ["InteractionGraphs", "SyntheticData"],
        ["NNPruning", "Sparsity"], ["NNPruning", "ML"],
        ["GSP", "Laplacian"], ["GNN", "ML"], ["Manifold", "ML"], ["Learnability", "ML"], ["KTrees", "Chordal"],

        // signals
        ["DFM", "Kalman"], ["DFM", "FactorModels"], ["DFM", "SyntheticData"],
        ["Wavelets", "NonStationarity"], ["Wavelets", "Fourier"], ["OU", "SyntheticData"],

        // finance
        ["StrategyCorr", "Backtesting"], ["StrategyCorr", "MultipleTesting"], ["StrategyCorr", "CorrEstimation"],
        ["StrategyCorr", "Breadth"], ["StrategyCorr", "OU"], ["StrategyCorr", "FactorModels"],
        ["StrategyCorr", "TSClustering"],
        ["Portfolio", "Diversification"], ["Portfolio", "HRP"], ["Portfolio", "MinVar"], ["HRP", "Agglomerative"],
        ["Bandits", "ML"], ["Bandits", "Backtesting"], ["Microstructure", "InteractingAgents"],

        // complexity
        ["IsingFin", "Ising"], ["IsingFin", "Collective"], ["IsingFin", "ABM"], ["IsingFin", "InteractingAgents"],
        ["Matchups", "GameTheory"], ["Matchups", "EvolvingNetworks"], ["Matchups", "Boltzmann"],
        ["Matchups", "TMFG"], ["Matchups", "ABM"],
        ["TxFlow", "FinNetworks"], ["TxFlow", "CreditRisk"], ["TxFlow", "StressTesting"], ["TxFlow", "ABM"],
        ["TxFlow", "SystemicRisk"],
        ["ECIInvest", "ECI"], ["ECIInvest", "ABM"], ["ECIInvest", "SyntheticData"],
        ["SystemicRisk", "FinNetworks"], ["InteractingAgents", "EvolvingNetworks"], ["FinNetworks", "LeadLag"]
    ];

    const STATUS = { published: "Published", preprint: "Preprint", post: "Blog post", ongoing: "In progress" };
    const TYPE   = { center: "", thesis: "Dissertation", theme: "Research theme", project: "Project", concept: "Concept" };
    const RADIUS = { center: 24, thesis: 14, theme: 17, project: 11, concept: 5.5 };
    const PRIORITY = { center: 0, thesis: 1, project: 2, concept: 3 };

    /* =====================================================================
       2. BUILD GRAPH
       ===================================================================== */
    const wrapper = document.getElementById("graph-container");
    if (typeof d3 === "undefined") {
        wrapper.insertAdjacentHTML("beforeend", '<p style="padding:1em;color:#94a3b8">The graph could not load.</p>');
        return;
    }

    const themeById = new Map(THEMES.map(t => [t.id, t]));
    const nodes = [], byId = new Map();
    const addNode = n => { n.themes = [].concat(n.theme || []); n.r = RADIUS[n.type]; nodes.push(n); byId.set(n.id, n); };

    addNode({ ...CENTER });
    THEMES.forEach(t => addNode({ id: t.id, label: t.label, type: "theme", theme: t.id, desc: t.desc }));
    NODES.forEach(n => addNode({ ...n }));

    const links = [], linkKeys = new Set();
    function addLink(a, b, kind) {
        if (!byId.has(a) || !byId.has(b)) { console.warn("[graph] unknown node in link:", a, b); return; }
        const key = a < b ? a + "|" + b : b + "|" + a;
        if (a === b || linkKeys.has(key)) return;
        linkKeys.add(key);
        links.push({ source: a, target: b, kind });
    }
    const home = id => byId.get(id).themes[0];

    THEMES.forEach(t => addLink("Core", t.id, "spoke"));
    nodes.filter(n => n.type === "project").forEach(n => n.themes.forEach(t => addLink(n.id, t, "hub")));
    LINKS.forEach(([a, b]) => addLink(a, b, "edge"));
    // Concepts with no edge inside their own cluster get attached to their theme hub
    nodes.filter(n => n.type === "concept").forEach(n => {
        const ok = links.some(l => (l.source === n.id && home(l.target) === home(n.id)) ||
                                   (l.target === n.id && home(l.source) === home(n.id)));
        if (!ok) addLink(n.id, n.themes[0], "hub");
    });
    links.forEach(l => {
        const a = home(l.source), b = home(l.target);
        l.cross = l.kind !== "spoke" && !(a && a === b);
        l.color = l.cross ? null : themeById.get(a)?.color;
    });

    const adjacency = new Map(nodes.map(n => [n.id, new Set([n.id])]));
    links.forEach(l => { adjacency.get(l.source).add(l.target); adjacency.get(l.target).add(l.source); });

    const colorOf = n => n.type === "center" ? "#f8fafc" : n.type === "thesis" ? "#e2e8f0" : themeById.get(n.themes[0]).color;

    /* ---- cluster anchors on an ellipse matching the container's aspect ---- */
    const aspect = Math.max(0.55, Math.min(1.8, (wrapper.clientWidth || 1000) / (wrapper.clientHeight || 700)));
    const R = 410, rx = R * Math.sqrt(aspect), ry = R / Math.sqrt(aspect);
    const anchors = new Map(THEMES.map((t, i) => {
        const a = -Math.PI / 2 + (i * 2 * Math.PI) / THEMES.length;
        return [t.id, [rx * Math.cos(a), ry * Math.sin(a)]];
    }));
    nodes.forEach(n => {
        if (!n.themes.length) { n.tx = 0; n.ty = 0; }
        else {
            const w = n.themes.map((_, i) => (i === 0 ? (n.themes.length === 1 ? 1 : 0.62) : 0.38 / (n.themes.length - 1)));
            n.tx = d3.sum(n.themes, (t, i) => w[i] * anchors.get(t)[0]);
            n.ty = d3.sum(n.themes, (t, i) => w[i] * anchors.get(t)[1]);
        }
        n.x = n.tx + (Math.random() - 0.5) * 90;
        n.y = n.ty + (Math.random() - 0.5) * 90;
    });
    const core = byId.get("Core"); core.fx = 0; core.fy = 0;
    const thesis = byId.get("Thesis"); if (thesis) { thesis.tx = 0; thesis.ty = 95; thesis.x = 0; thesis.y = 95; }

    /* =====================================================================
       3. RENDER
       ===================================================================== */
    const svg = d3.select("#project-network");
    const svgEl = svg.node();
    const viewport = svg.append("g");
    const hullLayer = viewport.append("g");
    const linkLayer = viewport.append("g");
    const nodeLayer = viewport.append("g");
    const regionLayer = viewport.append("g");

    const hullNodes = new Map(THEMES.map(t => [t.id, nodes.filter(n => n.themes[0] === t.id)]));
    const hull = hullLayer.selectAll("path")
        .data(THEMES).join("path")
        .attr("class", "hull")
        .attr("fill", t => t.color).attr("stroke", t => t.color);
    const hullLine = d3.line().curve(d3.curveCatmullRomClosed.alpha(0.6));

    const link = linkLayer.selectAll("line")
        .data(links).join("line")
        .attr("class", l => `link ${l.kind}${l.cross ? " cross" : ""}`)
        .attr("stroke", l => l.color || null);

    const node = nodeLayer.selectAll(".node")
        .data(nodes).join("g")
        .attr("class", d => `node node-${d.type}${d.status === "ongoing" ? " ongoing" : ""}`);

    node.append("circle")
        .attr("r", d => d.r)
        .attr("fill", colorOf)
        .style("stroke", d => (d.status === "ongoing" ? colorOf(d) : null));

    const label = node.filter(d => d.type !== "theme").append("text")
        .text(d => d.label);
    const labelled = nodes.filter(d => d.type !== "theme")
        .sort((a, b) => PRIORITY[a.type] - PRIORITY[b.type]);   // big labels claim space first

    const region = regionLayer.selectAll("text")
        .data(THEMES).join("text")
        .attr("class", "region-label")
        .attr("fill", t => t.color)
        .text(t => t.label.toUpperCase());
    region.attr("text-anchor", "middle").each(function (t) {
        t.textEl = this;
        t.prefer = anchors.get(t.id)[1] > 1 ? "below" : "above";   // default: outward
    });

    /* ---- overlay UI ---- */
    const ui = d3.select(wrapper);
    const legend = ui.append("div").attr("class", "kg-panel kg-legend")
        .html(`<details ${wrapper.clientWidth < 640 ? "" : "open"}><summary>Themes</summary><ul></ul>
               <div class="kg-key"><span><i class="fill"></i>Published / post</span><span><i class="ring"></i>In progress</span></div></details>`);
    const legendItems = legend.select("ul").selectAll("li").data(THEMES).join("li")
        .append("button").attr("type", "button")
        .html(t => `<span class="kg-dot" style="background:${t.color}"></span>${t.label}`)
        .on("click", (e, t) => selectTheme(t.id));

    const tools = ui.append("div").attr("class", "kg-panel kg-tools");
    const search = tools.append("input").attr("type", "search").attr("placeholder", "Search…").attr("aria-label", "Search the graph");
    tools.append("button").attr("type", "button").attr("title", "Zoom in").text("+").on("click", () => zoomBy(1.4));
    tools.append("button").attr("type", "button").attr("title", "Zoom out").text("−").on("click", () => zoomBy(1 / 1.4));
    tools.append("button").attr("type", "button").attr("title", "Fit graph").html("&#x2922;").on("click", () => fit(true));

    const card = ui.append("div").attr("class", "kg-panel kg-card");
    const hint = ui.append("div").attr("class", "kg-panel kg-hint").text(
        /Mac|iPhone|iPad/.test(navigator.platform) ? "Hold ⌘ and scroll to zoom" : "Hold Ctrl and scroll to zoom");

    /* =====================================================================
       4. SIMULATION
       ===================================================================== */
    const simulation = d3.forceSimulation(nodes)
        .force("link", d3.forceLink(links).id(d => d.id)
            .distance(l => l.kind === "spoke" ? 300 : l.kind === "hub" ? (l.source.type === "project" ? 88 : 68)
                                                   : l.cross ? 140 : 58)
            .strength(l => l.kind === "spoke" ? 0 : l.cross ? 0.05 : l.kind === "hub" ? 0.35 : 0.5))
        .force("charge", d3.forceManyBody().strength(d => d.type === "project" ? -340 : -18 * d.r - 40).distanceMax(380))
        .force("x", d3.forceX(d => d.tx).strength(d => d.type === "theme" ? 0.5 : d.type === "thesis" ? 0.3 : 0.07))
        .force("y", d3.forceY(d => d.ty).strength(d => d.type === "theme" ? 0.5 : d.type === "thesis" ? 0.3 : 0.07))
        .force("collide", d3.forceCollide(d => d.r + (d.type === "concept" ? 8 : d.type === "project" ? 22 : 14)).strength(0.85))
        .stop();


    function render() {
        link.attr("x1", d => d.source.x).attr("y1", d => d.source.y)
            .attr("x2", d => d.target.x).attr("y2", d => d.target.y);
        node.attr("transform", d => `translate(${d.x},${d.y})`);
        hull.attr("d", t => {
            const pts = [];
            hullNodes.get(t.id).forEach(n => {
                const pad = n.r + 24;
                for (let k = 0; k < 8; k++) pts.push([n.x + pad * Math.cos(k * Math.PI / 4), n.y + pad * Math.sin(k * Math.PI / 4)]);
            });
            const h = d3.polygonHull(pts);
            return h ? hullLine(h) : null;
        });
        layoutLabels(lsOf(currentK));
    }

    /* ---- label placement: each label takes the side (right/left/above/below) with least overlap ---- */
    const lsOf = k => Math.min(2.6, Math.max(0.7, 1 / k));      // labels keep ~constant on-screen size
    let currentK = 1;

    function measureLabels() {
        const prev = svgEl.style.getPropertyValue("--ls");
        svgEl.style.setProperty("--ls", 1);
        label.each(function (d) { d.tw = this.getComputedTextLength(); d.th = parseFloat(getComputedStyle(this).fontSize) || 13; });
        region.each(function (t) { t.tw = this.getComputedTextLength(); t.th = parseFloat(getComputedStyle(this).fontSize) || 14; });
        svgEl.style.setProperty("--ls", prev || 1);
    }

    function labelBox(d, side, ls) {
        const w = d.tw * ls, h = d.th * ls * 1.1, g = d.r + 4;
        if (side === "R") return [d.x + g, d.y - h / 2, d.x + g + w, d.y + h / 2];
        if (side === "L") return [d.x - g - w, d.y - h / 2, d.x - g, d.y + h / 2];
        if (side === "T") return [d.x - w / 2, d.y - g - h, d.x + w / 2, d.y - g];
        return [d.x - w / 2, d.y + g, d.x + w / 2, d.y + g + h];
    }
    const overlap = (a, b) =>
        Math.max(0, Math.min(a[2], b[2]) - Math.max(a[0], b[0])) * Math.max(0, Math.min(a[3], b[3]) - Math.max(a[1], b[1]));

    let highlightActive = false;
    function layoutLabels(ls) {
        const placed = [];
        const circles = nodes.map(n => [n.x - n.r, n.y - n.r, n.x + n.r, n.y + n.r, n]);
        const zoomed = svg.classed("zoomed");
        // a label counts as an obstacle only if it is actually shown
        const shown = d => (highlightActive ? d.hl : d.type !== "concept" || zoomed);
        const order = highlightActive ? labelled.filter(d => d.hl).concat(labelled.filter(d => !d.hl)) : labelled;
        order.forEach(d => {
            if (highlightActive && !d.hl && d.side) { d.box = labelBox(d, d.side, ls); return; }   // dimmed: leave as is
            const outward = d.x < -25 ? "L" : "R";
            let best = null, bestScore = Infinity;
            for (const side of ["R", "L", "T", "B"]) {
                const box = labelBox(d, side, ls);
                let score = (side === outward ? 0 : side === "T" || side === "B" ? 30 : 15) * ls * ls;
                for (const p of placed) score += overlap(box, p);
                for (const c of circles) if (c[4] !== d) score += 2 * overlap(box, c);
                if (side === d.side) score *= 0.85;                    // hysteresis: avoid flicker
                if (score < bestScore) { bestScore = score; best = side; }
            }
            if (best !== d.side) {
                d.side = best;
                const g = d.r + 4;
                d3.select(d.textEl)
                    .attr("text-anchor", best === "R" ? "start" : best === "L" ? "end" : "middle")
                    .attr("x", best === "R" ? g : best === "L" ? -g : 0)
                    .attr("y", best === "T" ? -g : best === "B" ? g : 0)
                    .attr("dy", best === "T" ? "-0.3em" : best === "B" ? "0.95em" : "0.35em");
            }
            d.box = labelBox(d, d.side, ls);
            if (shown(d)) placed.push(d.box);
        });
        // theme names: centred above or below their cluster, whichever side is less crowded
        const regionBoxes = [];
        THEMES.forEach(t => {
            let top = Infinity, bottom = -Infinity;
            hullNodes.get(t.id).forEach(n => {
                top = Math.min(top, n.y - n.r); bottom = Math.max(bottom, n.y + n.r);
                if (n.box && (n.type !== "concept" || zoomed)) { top = Math.min(top, n.box[1]); bottom = Math.max(bottom, n.box[3]); }
            });
            const hub = byId.get(t.id), w = t.tw * ls, h = t.th * ls, gap = 14 * ls;
            const cand = {
                above: [hub.x - w / 2, top - gap - h, hub.x + w / 2, top - gap],
                below: [hub.x - w / 2, bottom + gap, hub.x + w / 2, bottom + gap + h]
            };
            let best = null, bestScore = Infinity;
            for (const side of ["above", "below"]) {
                let score = (side === t.prefer ? 0 : 40) * ls * ls;
                for (const p of placed) score += overlap(cand[side], p);
                for (const p of regionBoxes) score += 3 * overlap(cand[side], p);
                for (const c of circles) score += 2 * overlap(cand[side], c);
                if (side === t.valign) score *= 0.85;
                if (score < bestScore) { bestScore = score; best = side; }
            }
            if (best !== t.valign) { t.valign = best; t.textEl.setAttribute("dy", best === "below" ? "0.8em" : "0em"); }
            t.box = cand[best];
            t.lx = hub.x;
            t.ly = best === "below" ? bottom + gap : top - gap;
            regionBoxes.push(t.box);
        });
        region.attr("x", t => t.lx).attr("y", t => t.ly);
    }

    label.each(function (d) { d.textEl = this; });
    measureLabels();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { measureLabels(); render(); });
    simulation.tick(260);   // settle off-screen so the first frame already looks calm
    render();
    simulation.on("tick", render);

    node.call(d3.drag()
        .on("start", (e, d) => { if (!e.active) simulation.alphaTarget(0.25).restart(); d.fx = d.x; d.fy = d.y; })
        .on("drag",  (e, d) => { d.fx = e.x; d.fy = e.y; })
        .on("end",   (e, d) => {
            if (!e.active) simulation.alphaTarget(0);
            if (d.type === "center") { d.fx = 0; d.fy = 0; } else { d.fx = null; d.fy = null; }
        }));

    /* =====================================================================
       5. ZOOM & PAN  (plain scrolling still scrolls the page)
       ===================================================================== */
    let fitK = 1, hintTimer = null;
    const zoom = d3.zoom()
        .scaleExtent([0.15, 5])
        .filter(e => {
            if (e.type === "wheel") {
                if (e.ctrlKey || e.metaKey) return true;
                hint.classed("show", true); clearTimeout(hintTimer);
                hintTimer = setTimeout(() => hint.classed("show", false), 1200);
                return false;
            }
            if (e.type === "touchstart") return e.touches.length > 1;
            if (e.type === "dblclick") return false;
            return !e.button;
        })
        .wheelDelta(e => {
            let d = -e.deltaY * (e.deltaMode === 1 ? 0.05 : e.deltaMode ? 1 : 0.002);
            if (e.ctrlKey && Math.abs(e.deltaY) < 40) d *= 8;     // trackpad pinch
            return Math.max(-0.5, Math.min(0.5, d));
        })
        .on("zoom", e => {
            viewport.attr("transform", e.transform);
            const k = (currentK = e.transform.k);
            svgEl.style.setProperty("--ls", lsOf(k).toFixed(3));
            svg.classed("zoomed", k > fitK * 1.45 && k > 0.6);
            svg.classed("overview", k < 0.42);
            layoutLabels(lsOf(k));
        });
    svg.call(zoom);

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ease = sel => (reduceMotion ? sel : sel.transition().duration(650));

    function fit(animate) {
        const W = wrapper.clientWidth, H = wrapper.clientHeight;
        // keep clear of the legend when it is open on a wide screen
        const left = W >= 900 && legend.select("details").property("open")
            ? legend.node().getBoundingClientRect().width + 20 : 0;
        const top = left ? 0 : 52;
        const aw = W - left, ah = H - top;
        let k = currentK, x0, x1, y0, y1;
        for (let i = 0; i < 4; i++) {          // label sizes depend on zoom, so iterate to a fixed point
            const ls = lsOf(k);
            layoutLabels(ls);
            x0 = y0 = Infinity; x1 = y1 = -Infinity;
            const grow = b => { x0 = Math.min(x0, b[0]); y0 = Math.min(y0, b[1]); x1 = Math.max(x1, b[2]); y1 = Math.max(y1, b[3]); };
            nodes.forEach(n => {
                grow([n.x - n.r, n.y - n.r, n.x + n.r, n.y + n.r]);
                if (n.box && n.type !== "concept" && !(k < 0.42 && n.type !== "center")) grow(n.box);
            });
            THEMES.forEach(t => grow(t.box));
            k = Math.max(0.15, Math.min(1.6, 0.96 * Math.min(aw / (x1 - x0), ah / (y1 - y0))));
        }
        fitK = k;
        const t = d3.zoomIdentity.translate(left + aw / 2, top + ah / 2).scale(k).translate(-(x0 + x1) / 2, -(y0 + y1) / 2);
        (animate ? ease(svg) : svg).call(zoom.transform, t);
    }
    const zoomBy = f => ease(svg).call(zoom.scaleBy, f);

    // Zoom so that a group of nodes fills the view (used when a theme is selected)
    function zoomToNodes(list) {
        const W = wrapper.clientWidth, H = wrapper.clientHeight;
        const left = W >= 900 && legend.select("details").property("open")
            ? legend.node().getBoundingClientRect().width + 20 : 0;
        const aw = W - left - 220, ah = H - 160;                   // screen margin for labels
        const [x0, x1] = d3.extent(list, n => n.x), [y0, y1] = d3.extent(list, n => n.y);
        const k = Math.max(fitK, Math.min(2.4, Math.min(aw / (x1 - x0 + 40), ah / (y1 - y0 + 40))));
        ease(svg).call(zoom.transform, d3.zoomIdentity
            .translate(left + (W - left) / 2, H / 2).scale(k).translate(-(x0 + x1) / 2, -(y0 + y1) / 2));
    }
    function selectTheme(id) {
        themeFocus = themeFocus === id ? null : id;
        focus = null;
        applyState();
        if (themeFocus) zoomToNodes(nodes.filter(n => n.themes.includes(themeFocus)));
        else fit(true);
    }
    legend.select("details").on("toggle", () => fit(true));
    fit(false);
    simulation.alpha(0.12).restart();   // a gentle final settle on screen

    let resizeTimer;
    new ResizeObserver(() => { clearTimeout(resizeTimer); resizeTimer = setTimeout(() => fit(true), 200); }).observe(wrapper);

    /* =====================================================================
       6. HIGHLIGHT, FOCUS, SEARCH, INFO CARD
       ===================================================================== */
    let hoverNode = null, focus = null, themeFocus = null, query = "", lastPointer = "mouse";
    wrapper.addEventListener("pointerdown", e => { lastPointer = e.pointerType || "mouse"; }, true);

    function setHighlight(nodeSet, linkTest) {
        svg.classed("has-highlight", !!nodeSet);
        region.classed("hl", t => !!nodeSet && nodeSet.has(t.id));
        node.classed("hl", d => (d.hl = !!nodeSet && nodeSet.has(d.id)));
        link.classed("hl", l => !!nodeSet && linkTest(l));
        highlightActive = !!nodeSet;
        layoutLabels(lsOf(currentK));
    }

    function applyState() {
        const n = hoverNode || focus;
        legendItems.classed("active", t => t.id === themeFocus);
        if (n) {
            const nb = adjacency.get(n.id);
            setHighlight(nb, l => l.source === n || l.target === n);
            showCard(n);
        } else if (themeFocus) {
            const set = new Set([themeFocus]);
            nodes.forEach(d => { if (d.themes.includes(themeFocus)) set.add(d.id); });
            setHighlight(set, l => set.has(l.source.id) && set.has(l.target.id) && l.kind !== "spoke");
            showCard(byId.get(themeFocus));
        } else if (query.length > 1) {
            const set = new Set(nodes.filter(d => (d.label + " " + (d.desc || "")).toLowerCase().includes(query)).map(d => d.id));
            setHighlight(set, l => set.has(l.source.id) && set.has(l.target.id));
            showDefault(set.size ? `${set.size} match${set.size > 1 ? "es" : ""} — press Enter to jump to the first.` : "No matches.");
        } else {
            setHighlight(null);
            showDefault();
        }
    }

    function linkFor(n) {
        if (!n.url || n.url === "#" || n.type === "center") return "";
        const ext = /^https?:/.test(n.url);
        const text = /arxiv\.org/.test(n.url) ? "Read on arXiv" : ext ? "Open link" : "Read the post";
        return ` <a href="${n.url}"${ext ? ' target="_blank" rel="noopener"' : ""}>${text} →</a>`;
    }

    function showCard(n) {
        const theme = n.themes.length ? n.themes.map(t => themeById.get(t).label).join(" · ") : "";
        const meta = [TYPE[n.type], STATUS[n.status], n.type !== "theme" ? theme : null,
                      `${adjacency.get(n.id).size - 1} connections`].filter(Boolean).join("  ·  ");
        card.html(`<div class="title" style="color:${n.type === "center" ? "#f8fafc" : colorOf(n)}">${n.label}</div>
                   <div class="meta">${meta}</div>
                   ${n.desc ? `<div class="desc">${n.desc}${linkFor(n)}</div>` : (linkFor(n) ? `<div class="desc">${linkFor(n)}</div>` : "")}`);
    }

    function showDefault(msg) {
        const touch = lastPointer === "touch";
        card.html(`<div class="hint">${msg || (touch
            ? "Tap a node to explore its neighbourhood · two fingers to zoom."
            : "Hover to explore · click posts &amp; papers to open them · drag to pan · Ctrl/⌘ + scroll to zoom.")}</div>`);
    }

    function go(n) {
        if (/^https?:/.test(n.url)) window.open(n.url, "_blank", "noopener");
        else window.location.href = n.url;
    }

    node.on("pointerenter", (e, d) => { if (e.pointerType !== "mouse") return; hoverNode = d; applyState(); })
        .on("pointerleave", (e)    => { if (e.pointerType !== "mouse") return; hoverNode = null; applyState(); })
        .on("click", (e, d) => {
            e.stopPropagation();
            const touch = lastPointer !== "mouse";
            const hasUrl = d.url && d.url !== "#" && d.type !== "center";
            if (hasUrl && (!touch || focus === d)) return go(d);   // touch: first tap previews, second tap opens
            if (d.type === "theme") return selectTheme(d.id);
            focus = focus === d ? null : d; themeFocus = null;
            hoverNode = touch ? null : hoverNode;
            applyState();
        });

    svg.on("click", e => {
        if (e.target === svgEl || e.target.classList.contains("hull")) {
            const hadTheme = !!themeFocus;
            focus = null; themeFocus = null; applyState();
            if (hadTheme) fit(true);
        }
    });

    search.on("input", e => { query = e.target.value.trim().toLowerCase(); focus = null; themeFocus = null; applyState(); })
          .on("keydown", e => {
              if (e.key === "Escape") { e.target.value = ""; query = ""; applyState(); return; }
              if (e.key !== "Enter" || query.length < 2) return;
              const m = nodes.find(d => (d.label + " " + (d.desc || "")).toLowerCase().includes(query));
              if (!m) return;
              focus = m; applyState();
              ease(svg).call(zoom.transform, d3.zoomIdentity
                  .translate(wrapper.clientWidth / 2, wrapper.clientHeight / 2)
                  .scale(Math.max(fitK * 1.6, d3.zoomTransform(svgEl).k)).translate(-m.x, -m.y));
          });

    applyState();
})();
</script>