<!--
  Research knowledge graph — drop-in replacement for the old project graph.
  Same framework: inline <style>, #graph-container / #project-network, D3 v7, one IIFE.

  To edit content, change only section 1 of the script (THEMES / NODES / LINKS):
    • type: "project" (papers, posts, ongoing work) or "concept" (methods & ideas)
    • theme: one theme id, or an array — the first is the "home" cluster,
             extra ones pull the node toward a bridge position between clusters
    • status (projects): "published" | "preprint" | "post" | "ongoing"
    • url: internal post ("/posts/…/") or external link (opens in a new tab)
  Projects are linked to their theme(s) automatically, and any concept with no link
  inside its own theme is attached to its theme hub, so LINKS only needs the content edges.
-->
<style>
    #graph-container {
        --text-color: #f8fafc;
        --muted: #94a3b8;
        --halo: rgba(15, 23, 42, 0.92);
        --panel-bg: rgba(15, 23, 42, 0.82);
        --panel-border: rgba(148, 163, 184, 0.2);
        --ls: 1;                                /* label scale, set from zoom level */
        width: 100%;
        height: clamp(540px, 82vh, 860px);
        background: transparent;
        position: relative;
        z-index: 10;
        overflow: hidden;
        font-family: inherit;
        color: var(--text-color);
        user-select: none;
        -webkit-user-select: none;
    }

    #project-network {
        width: 100%;
        height: 100%;
        display: block;
        cursor: grab;
        touch-action: pan-x pan-y;   /* one finger scrolls the page; two fingers zoom the graph */
    }
    #project-network:active { cursor: grabbing; }

    /* ---------- clusters ---------- */
    #graph-container .hull {
        fill-opacity: 0.055;
        stroke-opacity: 0.16;
        stroke-width: 1.5px;
        stroke-linejoin: round;
        transition: opacity 0.3s;
    }

    /* ---------- links ---------- */
    #graph-container .link {
        stroke-width: 1.2px;
        stroke-opacity: 0.28;
        transition: stroke-opacity 0.25s, stroke-width 0.25s;
    }
    #graph-container .link.cross { stroke: #94a3b8; stroke-opacity: 0.14; stroke-dasharray: 3 4; }
    #graph-container .link.spoke { stroke: #cbd5e1; stroke-opacity: 0.16; stroke-width: 1.8px; }

    /* ---------- nodes ---------- */
    #graph-container .node { cursor: pointer; touch-action: none; transition: opacity 0.25s; }
    #graph-container .node circle { stroke: #0f172a; stroke-width: 1.5px; }
    #graph-container .node-project circle,
    #graph-container .node-theme circle { stroke-width: 2px; }
    #graph-container .node.ongoing circle {
        fill-opacity: 0.18;
        stroke-width: 2.4px;
        stroke-dasharray: 4 3;
    }

    /* Professional, subtle pulsing for the 'Me' node */
    @keyframes pulse {
        0%   { stroke-width: 2px; stroke-opacity: 1; }
        50%  { stroke-width: 7px; stroke-opacity: 0.45; }
        100% { stroke-width: 2px; stroke-opacity: 1; }
    }
    #graph-container .node-center circle { stroke: #38bdf8; animation: pulse 3s infinite ease-in-out; }

    /* ---------- labels (counter-scaled so they stay readable at any zoom) ---------- */
    #graph-container .node text {
        fill: var(--text-color);
        font-size: calc(12.5px * var(--ls));
        font-weight: 400;
        pointer-events: none;
        paint-order: stroke;
        stroke: var(--halo);
        stroke-width: calc(3.5px * var(--ls));
        stroke-linejoin: round;
        transition: opacity 0.25s;
    }
    #graph-container .node-center text  { font-size: calc(18px * var(--ls)); font-weight: 600; }
    #graph-container .node-thesis text  { font-size: calc(14px * var(--ls)); font-weight: 500; font-style: italic; }
    #graph-container .node-theme text   { font-size: calc(15.5px * var(--ls)); font-weight: 600; letter-spacing: 0.01em; }
    #graph-container .node-project text { font-size: calc(13px * var(--ls)); }
    #graph-container .node-concept text { font-size: calc(11.5px * var(--ls)); fill: #cbd5e1; opacity: 0; }
    #project-network.zoomed .node-concept text { opacity: 1; }
    #project-network.overview .node-project text,
    #project-network.overview .node-thesis text { opacity: 0; }

    /* theme names sit on the outer rim of each cluster, like regions on a map */
    #graph-container .region-label {
        font-size: calc(13.5px * var(--ls));
        font-weight: 700;
        letter-spacing: 0.12em;
        pointer-events: none;
        paint-order: stroke;
        stroke: var(--halo);
        stroke-width: calc(4px * var(--ls));
        stroke-linejoin: round;
        transition: opacity 0.25s;
    }
    #project-network.has-highlight .region-label    { opacity: 0.3; }
    #project-network.has-highlight .region-label.hl { opacity: 1; }

    /* ---------- highlight state ---------- */
    #project-network.has-highlight .node        { opacity: 0.13; }
    #project-network.has-highlight .node.hl     { opacity: 1; }
    #project-network.has-highlight .node.hl text { opacity: 1; }
    #project-network.has-highlight .link        { stroke-opacity: 0.035; }
    #project-network.has-highlight .link.hl     { stroke-opacity: 0.9; stroke-width: 2px; }
    #project-network.has-highlight .link.cross.hl { stroke: #e2e8f0; stroke-opacity: 0.7; }
    #project-network.has-highlight .hull        { opacity: 0.35; }

    /* ---------- overlay panels ---------- */
    #graph-container .kg-panel {
        position: absolute;
        background: var(--panel-bg);
        border: 1px solid var(--panel-border);
        border-radius: 10px;
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        font-size: 13px;
        line-height: 1.45;
        z-index: 2;
    }
    #graph-container .kg-legend { top: 12px; left: 12px; padding: 8px 12px; max-width: 260px; }
    #graph-container .kg-legend summary {
        cursor: pointer; font-weight: 600; color: var(--muted); font-size: 12px;
        text-transform: uppercase; letter-spacing: 0.06em; list-style: none;
    }
    #graph-container .kg-legend summary::-webkit-details-marker { display: none; }
    #graph-container .kg-legend summary::after { content: " ▾"; }
    #graph-container .kg-legend details:not([open]) summary::after { content: " ▸"; }
    #graph-container .kg-legend ul { list-style: none; margin: 8px 0 0; padding: 0; }
    #graph-container .kg-legend li button {
        all: unset; cursor: pointer; display: flex; align-items: center; gap: 8px;
        padding: 3px 6px; margin: 0 -6px; border-radius: 6px; width: 100%; box-sizing: border-box;
        color: var(--text-color); font-size: 13px;
    }
    #graph-container .kg-legend li button:hover,
    #graph-container .kg-legend li button.active { background: rgba(148, 163, 184, 0.16); }
    #graph-container .kg-dot { width: 11px; height: 11px; border-radius: 50%; flex: none; }
    #graph-container .kg-key {
        display: flex; gap: 14px; margin-top: 8px; padding-top: 8px;
        border-top: 1px solid var(--panel-border); color: var(--muted); font-size: 12px;
    }
    #graph-container .kg-key span { display: flex; align-items: center; gap: 6px; }
    #graph-container .kg-key .ring { width: 10px; height: 10px; border-radius: 50%; border: 2px dashed #cbd5e1; }
    #graph-container .kg-key .fill { width: 12px; height: 12px; border-radius: 50%; background: #cbd5e1; }

    #graph-container .kg-tools { top: 12px; right: 12px; display: flex; gap: 6px; padding: 6px; }
    #graph-container .kg-tools input {
        all: unset; width: 150px; padding: 4px 8px; border-radius: 6px; font-size: 13px;
        background: rgba(148, 163, 184, 0.12); color: var(--text-color);
    }
    #graph-container .kg-tools input::placeholder { color: var(--muted); }
    #graph-container .kg-tools button {
        all: unset; cursor: pointer; width: 28px; height: 28px; text-align: center; line-height: 28px;
        border-radius: 6px; font-size: 16px; color: var(--text-color); background: rgba(148, 163, 184, 0.12);
    }
    #graph-container .kg-tools button:hover { background: rgba(148, 163, 184, 0.28); }

    #graph-container .kg-card { left: 12px; bottom: 12px; padding: 10px 14px; max-width: 340px; pointer-events: auto; }
    #graph-container .kg-card .title { font-weight: 600; font-size: 15px; }
    #graph-container .kg-card .meta  { color: var(--muted); font-size: 12px; margin: 2px 0 4px; }
    #graph-container .kg-card .desc  { font-size: 13px; }
    #graph-container .kg-card a      { color: #60a5fa; text-decoration: none; font-weight: 500; }
    #graph-container .kg-card a:hover { text-decoration: underline; }
    #graph-container .kg-card .hint  { color: var(--muted); font-size: 12.5px; }

    #graph-container .kg-hint {
        left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 10px 16px;
        opacity: 0; transition: opacity 0.3s; pointer-events: none; font-size: 14px;
    }
    #graph-container .kg-hint.show { opacity: 1; }

    @media (max-width: 640px) {
        #graph-container .kg-tools input { display: none; }
        #graph-container .kg-card { right: 12px; max-width: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        #graph-container .node-center circle { animation: none; }
        #graph-container .node, #graph-container .link, #graph-container .node text { transition: none; }
    }
</style>

<div id="graph-container">
